# SevFishComVBot 服务端配置模板
# 用法：cp .env.example .env && 编辑（.env 不进版本库）
# 本文件不含任何真实密钥；LLM 的 key/base_url/model 存在数据库的智能体行里，不在这里。

# ── 应用 ─────────────────────────────────────────────
APP_NAME=SevFishComVBot
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8765
# 必须 false：热重载会清空内存中的 WebSocket 连接注册表 → 设备被误判离线
RELOAD=false
SITE_URL=http://127.0.0.1:8765
COMPANY_NAME=你的公司名

# ── WebSocket ───────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30
WS_HEARTBEAT_TIMEOUT=90
WS_MAX_CONNECTIONS=1000

# ── 日志 ─────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=%(asctime)s | %(levelname)-8s | %(name)s | %(message)s
UPLOAD_DIR=uploads

# ── MySQL ────────────────────────────────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=aivbot
MYSQL_PASSWORD=请改成一个强口令
MYSQL_DATABASE=aivbot
MYSQL_POOL_MIN_SIZE=2
MYSQL_POOL_MAX_SIZE=20
# 仅 docker compose 用，不进容器环境
MYSQL_ROOT_PASSWORD=请改成一个强口令

# ── CORS（只有做前后端分离改造时才需要）────────────────
CORS_ORIGINS=[]
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*

# ── 外网客户控制台 /ext ───────────────────────────────
# 留空 = /ext 整体 403（默认关闭）。配了值之后，反代必须注入同名请求头
#   X-Tunnel-Secret: <EXT_TUNNEL_SECRET>
EXT_TUNNEL_SECRET=
EXT_SESSION_HOURS=72
# HTTPS 下设为 true
EXT_COOKIE_SECURE=false
# 没有云机/隧道时，用内网直接预览 /ext（仅私网来源）
EXT_LOCAL_PREVIEW=false
